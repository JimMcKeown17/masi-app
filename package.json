{
  "name": "nonprofit-field-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "sqlite:staging:check": "node scripts/sqlite-staging.cjs check",
    "sqlite:staging:link": "node scripts/sqlite-staging.cjs link",
    "sqlite:staging:migrations": "node scripts/sqlite-staging.cjs migration-list",
    "sqlite:staging:dry-run": "node scripts/sqlite-staging.cjs db-push-dry-run",
    "sqlite:staging:push": "node scripts/sqlite-staging.cjs db-push",
    "sqlite:staging:advisors": "node scripts/sqlite-staging.cjs advisors",
    "sqlite:staging:query": "node scripts/sqlite-staging.cjs query",
    "sqlite:staging:start": "node scripts/sqlite-staging.cjs start",
    "sqlite:staging:ios": "node scripts/sqlite-staging.cjs ios",
    "sqlite:staging:android": "node scripts/sqlite-staging.cjs android",
    "test": "jest",
    "test:integration": "jest --runInBand --config jest.integration.config.js",
    "test:release": "npm test && npm run test:integration && npm run sqlite:staging:check"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/bottom-tabs": "^7.10.1",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.10.1",
    "@supabase/supabase-js": "^2.100.1",
    "expo": "~54.0.32",
    "expo-file-system": "~19.0.21",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "^19.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "jest-expo": "~54.0.17",
    "react": "19.1.0",
    "react-hook-form": "^7.71.1",
    "react-native": "0.81.5",
    "react-native-get-random-values": "^2.0.0",
    "react-native-paper": "^5.14.5",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "uuid": "^13.0.0"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|react-native-paper|react-native-get-random-values|uuid)"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.claude/worktrees/",
      "/.codex/worktrees/"
    ],
    "modulePathIgnorePatterns": [
      "/.claude/worktrees/",
      "/.codex/worktrees/"
    ]
  },
  "private": true,
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "better-sqlite3": "^12.10.0",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "jest": "^29.7.0"
  }
}
