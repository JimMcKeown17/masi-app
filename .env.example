# No env is required to run against the forward backend: the app defaults to
# the masi-app-sqlite Supabase project (segygjzpujphwvrubusm) with committed
# publishable-key fallbacks (config/supabaseProjectConfig.js).
#
# Set these only to override the default. The URL must match the selected
# target's project or startup fails fast with an actionable error.
# EXPO_PUBLIC_SUPABASE_TARGET=sqlite-staging   # or "primary" for the retired legacy backend
# EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key
